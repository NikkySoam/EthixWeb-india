
PORT=5000

# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# Application environment: development | production | test
NODE_ENV=development

# Allowed CORS origins (frontend URLs)
CORS_ORIGIN=https://ethix-web-india.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:4173

# Admin login: store a bcrypt password hash, never a plaintext password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
JWT_SECRET=replace-with-long-random-secret


